{
  "name": "xenia-webserver",
  "version": "1.0.0",
  "description": "Xenia Web Services is a REST API designed to support the Xenia Xbox 360 emulator in providing online and multiplayer functionality. ",
  "author": "",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^22 || ^24"
  },
  "scripts": {
    "heroku-prebuild": "git clone --branch main https://github.com/AdrianCassar/TitleManagedStorageArchiveXbox360.git ./src/xstorage/title",
    "prebuild": "rimraf dist",
    "build": "npm run build:frontend && nest build",
    "build:frontend": "tsc -p src/frontend",
    "watch:frontend": "tsc -p src/frontend --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" test",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "prettier-check": "prettier \"src/**/*.ts\" --check",
    "prettier-write": "prettier \"src/**/*.ts\" --write",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "docker:build": "docker build -t xenia-webservices-backend:latest .",
    "docker:compose": "docker compose up"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/cqrs": "^12.0.0",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/sequelize": "^12.0.0",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/swagger": "^12.0.1",
    "axios": "^1.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "console-table-printer": "^2.16.1",
    "dotenv": "^18.0.1",
    "fast-glob": "^3.3.3",
    "fast-xml-parser": "^5.11.1",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "nestjs-real-ip": "^3.0.1",
    "obscenity": "^0.4.6",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "tiny-types": "^2.0.5",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.4",
    "@nestjs/testing": "^12.0.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "jest": "30.5.2",
    "prettier": "^3.9.8",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "uuid": "$uuid"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "roots": [
      "<rootDir>"
    ],
    "modulePaths": [
      "<rootDir>"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true
  }
}
